@prefix rrdom: <http://wfrp.ia/dominio/ciencia-tecnologia#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode rrdom:E1ConceptWithoutScheme ;
            sh:resultMessage "Todo skos:Concept debe pertenecer a un skos:ConceptScheme."@es ;
            sh:resultPath skos:inScheme ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Todo skos:Concept debe pertenecer a un skos:ConceptScheme."@es ;
                    sh:minCount 1 ;
                    sh:path skos:inScheme ] ] .

