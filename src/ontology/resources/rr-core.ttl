###  http://wfrp.ia/sentimiento/core#Negativo
rrsent:Negativo rdf:type owl:NamedIndividual ,
                         skos:Concept .


###  http://wfrp.ia/sentimiento/core#Neutro
rrsent:Neutro rdf:type owl:NamedIndividual ,
                       skos:Concept .


###  http://wfrp.ia/sentimiento/core#Positivo
rrsent:Positivo rdf:type owl:NamedIndividual ,
                         skos:Concept .


###  http://wfrp.ia/sentimiento/core#SentimentScheme
rrsent:SentimentScheme rdf:type owl:NamedIndividual ,
                                skos:ConceptScheme ;
                       skos:prefLabel "Esquema de Sentimiento"@es ,
                                      "Sentiment Scheme"@en .


#################################################################
#    Annotations
#################################################################

rrsent:Negativo skos:inScheme rrsent:SentimentScheme ;
                skos:prefLabel "Negative"@en ,
                               "Negativo"@es .


rrsent:Neutro skos:inScheme rrsent:SentimentScheme ;
              skos:prefLabel "Neutral"@en ,
                             "Neutro"@es .


rrsent:Positivo skos:inScheme rrsent:SentimentScheme ;
                skos:prefLabel "Positive"@en ,
                               "Positivo"@es .


