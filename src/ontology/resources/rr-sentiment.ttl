@prefix rr:     <http://wfrp.ia/ontologia/ia-sentimiento#> .
@prefix rrsent: <http://wfrp.ia/sentimiento/core#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

<http://wfrp.ia/sentimiento/core> a owl:Ontology ;
  dct:title   "Módulo de Sentimiento (IA-Reddit)"@es ;
  dct:created "2025-09-17"^^xsd:date ;
  owl:versionIRI <http://wfrp.ia/sentimiento/core/1.0> .

#################################################################
# Esquema de sentimiento, emoción, modalidad y objetivos
#################################################################

### Esquema SKOS para sentimientos
rrsent:SentimentScheme a skos:ConceptScheme ;
  skos:prefLabel "Esquema de Sentimiento"@es , "Sentiment Scheme"@en .

### Clase puente
rrsent:Sentiment a owl:Class ; rdfs:subClassOf skos:Concept ;
  rdfs:label "Sentimiento (clase)"@es .

### Polaridad (como individuos de la clase Sentiment)
rrsent:Positivo a rrsent:Sentiment, skos:Concept ;
  skos:inScheme rrsent:SentimentScheme ;
  skos:prefLabel "Positivo"@es , "Positive"@en .

rrsent:Neutro a rrsent:Sentiment, skos:Concept ;
  skos:inScheme rrsent:SentimentScheme ;
  skos:prefLabel "Neutro"@es , "Neutral"@en .

rrsent:Negativo a rrsent:Sentiment, skos:Concept ;
  skos:inScheme rrsent:SentimentScheme ;
  skos:prefLabel "Negativo"@es , "Negative"@en .

### Modificadores de polaridad
rrsent:ModificadorPolaridad a owl:Class ; rdfs:subClassOf skos:Concept .
rrsent:Negacion        a owl:Class ; rdfs:subClassOf rrsent:ModificadorPolaridad .
rrsent:Intensificador  a owl:Class ; rdfs:subClassOf rrsent:ModificadorPolaridad .
rrsent:Atenuador       a owl:Class ; rdfs:subClassOf rrsent:ModificadorPolaridad .

### Emociones
rrsent:Emocion a owl:Class ; rdfs:subClassOf skos:Concept .
rrsent:Miedo a owl:Class ; rdfs:subClassOf rrsent:Emocion .
rrsent:Esperanza a owl:Class ; rdfs:subClassOf rrsent:Emocion .
rrsent:Entusiasmo a owl:Class ; rdfs:subClassOf rrsent:Emocion .
rrsent:Escepticismo a owl:Class ; rdfs:subClassOf rrsent:Emocion .
rrsent:Frustracion a owl:Class ; rdfs:subClassOf rrsent:Emocion .

### Modalidad
rrsent:Modalidad a owl:Class ; rdfs:subClassOf skos:Concept .
rrsent:Especulativa a owl:Class ; rdfs:subClassOf rrsent:Modalidad .
rrsent:Cierta       a owl:Class ; rdfs:subClassOf rrsent:Modalidad .
rrsent:MixtaMod     a owl:Class ; rdfs:subClassOf rrsent:Modalidad .

### Objetivos del sentimiento
rrsent:ObjetivoSentimiento a owl:Class ; rdfs:subClassOf skos:Concept .
rrsent:Tecnologia     a owl:Class ; rdfs:subClassOf rrsent:ObjetivoSentimiento .
rrsent:Empresa        a owl:Class ; rdfs:subClassOf rrsent:ObjetivoSentimiento .
rrsent:UsuarioFinal   a owl:Class ; rdfs:subClassOf rrsent:ObjetivoSentimiento .
rrsent:Gobierno       a owl:Class ; rdfs:subClassOf rrsent:ObjetivoSentimiento .
rrsent:ImpactoSocial  a owl:Class ; rdfs:subClassOf rrsent:ObjetivoSentimiento .

### Metáforas
rrsent:Metafora a owl:Class ; rdfs:subClassOf skos:Concept .
rrsent:Amenaza a owl:Class ; rdfs:subClassOf rrsent:Metafora .
rrsent:Positiva a owl:Class ; rdfs:subClassOf rrsent:Metafora .

### Ética / Gobernanza
rrsent:TemaEtico a owl:Class ; rdfs:subClassOf skos:Concept .
rrsent:Equidad a owl:Class ; rdfs:subClassOf rrsent:TemaEtico .
rrsent:Transparencia a owl:Class ; rdfs:subClassOf rrsent:TemaEtico .
rrsent:Responsabilidad a owl:Class ; rdfs:subClassOf rrsent:TemaEtico .
rrsent:PrivacidadEtica a owl:Class ; rdfs:subClassOf rrsent:TemaEtico .

### Propiedades de anotación (léxico/labels) — en español
rrsent:polaridad a owl:AnnotationProperty ;
  rdfs:label "polaridad léxica (-1,0,1)"@es .
rrsent:tipoModificador a owl:AnnotationProperty ;
  rdfs:label "tipo de modificador (negación/intensificador/atenuador)"@es .
rrsent:peso a owl:AnnotationProperty ;
  rdfs:label "peso léxico/modificador (0..1)"@es .

# Aclaración: esta NO es la polaridad "Positivo"
rrsent:Positiva rdfs:comment
  "Clase de metáfora con connotación positiva; NO es la polaridad rrsent:Positivo."@es .

  [ a owl:AllDifferent ; owl:distinctMembers ( rrsent:Positivo rrsent:Neutro rrsent:Negativo ) ] .

